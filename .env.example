# ============================================================
# Horus SIEM — Configuración de despliegue
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# ============================================================

# IP o hostname por el que se accede al servidor.
# Déjalo en 'localhost' solo si TODO (dashboard, agente, móvil) corre en
# esta misma máquina. Para una demo con el móvil, pon la IP de la LAN.
#   Linux/macOS: hostname -I | awk '{print $1}'
#   Windows:     ipconfig
HORUS_HOST=localhost

# --- Credenciales del dashboard ---
ADMIN_USER=admin
ADMIN_PASSWORD=Horus2026!

# --- Canal agente <-> servidor ---
# Debe coincidir con el PSK configurado en los agentes
# (agents/config.json -> auth.psk, o el 3er argumento de setup_agent.sh).
HORUS_PSK=horus-default-psk
HORUS_REQUIRE_AGENT_PSK=true

# --- Firebase Cloud Messaging (push al móvil) ---
# 1. Firebase Console > Configuración del proyecto > Cuentas de servicio
# 2. "Generar nueva clave privada" y guardar el JSON como
#    serviceAccountKey.json en la raíz de este repositorio
# 3. Poner FIREBASE_ENABLED=true y el project_id real
# 4. docker compose up -d --build
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=

# Nivel mínimo de alerta que dispara una push (1-15).
# 8 = High. Bájalo a 4 si quieres ver más notificaciones en la demo.
PUSH_MIN_LEVEL=8

# --- CORS (opcional) ---
# Por defecto se permite localhost y http://${HORUS_HOST}:3000.
# Descoméntalo solo si necesitas orígenes adicionales.
# HORUS_CORS_ORIGINS=http://localhost:3000,http://192.168.1.100:3000
